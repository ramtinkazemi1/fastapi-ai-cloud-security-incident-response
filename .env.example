# Local API authentication. Replace this value outside development.
CIR_API_KEY=change-me-to-a-long-random-value
CIR_JWT_SECRET=change-me-to-at-least-32-random-bytes
CIR_ACCESS_TOKEN_MINUTES=60
CIR_RATE_LIMIT_REQUESTS=120
CIR_RATE_LIMIT_WINDOW_SECONDS=60

# Used when the API runs directly on the host.
CIR_DATABASE_URL=postgresql+asyncpg://incident_app:local-development-only@localhost:5434/incident_response

# Optional: enables POST /api/v1/alerts/{alert_id}/analyze.
CIR_OPENAI_API_KEY=
CIR_OPENAI_MODEL=gpt-4.1-mini

CIR_ENVIRONMENT=development
CIR_DEBUG=false
